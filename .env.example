# ==============================================================================
# PROSTOCK - MASTER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the root directory.
# 2. Fill in your real API keys below.
# 3. ProStock automatically reads this file on startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: "Sqlite" (Zero-config local file database) OR "PostgreSql" (TimescaleDB)
PROSTOCK_DATABASE_PROVIDER=Sqlite

# If PROSTOCK_DATABASE_PROVIDER=Sqlite:
PROSTOCK_SQLITE_CONNECTION="Data Source=prostock_local.db"

# If PROSTOCK_DATABASE_PROVIDER=PostgreSql (TimescaleDB):
# Format: Host=localhost;Port=5432;Database=prostock_db;Username=postgres;Password=YourSecurePassword;
PROSTOCK_POSTGRES_CONNECTION="Host=localhost;Port=5432;Database=prostock_db;Username=postgres;Password=prostock_password;"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY (NON-NEGOTIABLE FOR REAL MONEY PROTECTION)
# ------------------------------------------------------------------------------
# 256-bit secret key used to sign JWT tokens. Keep this secret!
PROSTOCK_JWT_SECRET="ProStock_Super_Secure_Institutional_JWT_Secret_Key_2026_AtLeast32BytesLong!"
PROSTOCK_JWT_ISSUER="ProStockServer"
PROSTOCK_JWT_AUDIENCE="ProStockClient"
PROSTOCK_JWT_EXPIRY_MINUTES=60
PROSTOCK_JWT_REFRESH_EXPIRY_DAYS=7

# Default Administrator Account (Auto-seeded on first boot)
PROSTOCK_ADMIN_EMAIL="admin@prostock.local"
PROSTOCK_ADMIN_PASSWORD="AdminProStockPassword2026!"

# ------------------------------------------------------------------------------
# 3. INDIAN EQUITIES & MCX COMMODITIES (DhanHQ API)
# ------------------------------------------------------------------------------
# Register for free at: https://dhanhq.co/
# NOTE: DhanHQ access tokens expire every 24 hours. The ProStock Settings UI
# allows you to refresh this token on the fly without restarting the server.
PROSTOCK_DHAN_CLIENT_ID="YOUR_DHAN_CLIENT_ID_HERE"
PROSTOCK_DHAN_ACCESS_TOKEN="YOUR_DHAN_DAILY_JWT_TOKEN_HERE"

# ------------------------------------------------------------------------------
# 4. US EQUITIES & PAPER TRADING (Alpaca Markets API)
# ------------------------------------------------------------------------------
# Register for free paper trading account at: https://alpaca.markets/
PROSTOCK_ALPACA_API_KEY="YOUR_ALPACA_API_KEY_HERE"
PROSTOCK_ALPACA_SECRET_KEY="YOUR_ALPACA_SECRET_KEY_HERE"
PROSTOCK_ALPACA_PAPER_URL="https://paper-api.alpaca.markets"

# ------------------------------------------------------------------------------
# 5. CRYPTOCURRENCY (Binance Public & Private API)
# ------------------------------------------------------------------------------
# Public live feeds do NOT require keys. Keys only needed for future crypto paper orders.
PROSTOCK_BINANCE_API_KEY="YOUR_BINANCE_API_KEY_HERE"
PROSTOCK_BINANCE_SECRET_KEY="YOUR_BINANCE_SECRET_KEY_HERE"

# ------------------------------------------------------------------------------
# 6. MOBILE PUSH NOTIFICATIONS & ALERTS (Telegram & Discord)
# ------------------------------------------------------------------------------
# Telegram: Create a bot via @BotFather and get your personal Chat ID via @userinfobot
PROSTOCK_TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
PROSTOCK_TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"

# Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook
PROSTOCK_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE"

# ------------------------------------------------------------------------------
# 7. LOCAL AI NEWS & TRADE EXPLAINER (Ollama / DeepSeek)
# ------------------------------------------------------------------------------
# Download Ollama from https://ollama.com/ and run: `ollama run deepseek-r1:8b`
PROSTOCK_OLLAMA_ENDPOINT="http://localhost:11434"
PROSTOCK_OLLAMA_MODEL="deepseek-r1:8b"

# ------------------------------------------------------------------------------
# 8. SYSTEM RISK THRESHOLDS (MONEY PROTECTION ENGINE)
# ------------------------------------------------------------------------------
# Max risk allowed on any single trade (percentage of total account equity)
PROSTOCK_MAX_SINGLE_TRADE_RISK_PERCENT=1.5

# Max total portfolio heat (sum of open trade risk percentages)
PROSTOCK_MAX_PORTFOLIO_HEAT_PERCENT=30.0

# Daily account drawdown circuit breaker (percentage loss that triggers instant trade halt)
PROSTOCK_DAILY_DRAWDOWN_LIMIT_PERCENT=3.0

# Maximum feed staleness in milliseconds before freezing signals
PROSTOCK_MAX_FEED_LATENCY_MS=3000
